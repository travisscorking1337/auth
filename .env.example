APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=console

# Local Auth connection to the published PostgreSQL port.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth
DB_USER=auth
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Auth connection from inside Docker Compose.
DB_HOST_COMPOSE=postgres
DB_PORT_COMPOSE=5432

# PostgreSQL container initialization.
POSTGRES_DB=auth
POSTGRES_USER=auth
POSTGRES_PASSWORD=change-me
